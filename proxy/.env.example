# Copy to .env and fill in. Process environment always wins over this file, so a
# platform secret store overrides it rather than fighting it.

# --- Bind ---------------------------------------------------------------------
# Loopback by default. A deployment behind a load balancer wants HOST=0.0.0.0.
PORT=8788
HOST=127.0.0.1

# --- The Migma secret ---------------------------------------------------------
# Both prefixes are secret; Migma publishes no browser-safe key type. This value
# is the reason the proxy exists: it never leaves this process.
# Scope the key in Migma's dashboard to reads plus email generation. Omitting
# scope at creation grants the full permission set, which includes email:send
# and billing:write, and this service needs neither.
MIGMA_API_KEY=sk_test_replace_me
MIGMA_BASE_URL=https://api.migma.ai/v1

# The deliverability route's upstream path is the one part of this bridge taken
# from a summary rather than read off the API reference. Confirm it against
# https://docs.migma.ai/api-reference/introduction and set this if it differs, so
# the correction is a restart and not a patch. Default: /validate/deliverability
MIGMA_VALIDATE_PATH=

# --- Session signing ----------------------------------------------------------
# 32 bytes minimum. Generate with: openssl rand -hex 32
# Rotating this invalidates every issued session; clients mint another on 401.
SESSION_SECRET=
SESSION_TTL_SECONDS=900

# --- CORS ---------------------------------------------------------------------
# Comma-separated exact origins. The Spotify desktop client serves its UI from
# xpui.app.spotify.com. Add http://localhost ports only for local development.
ALLOWED_ORIGINS=https://xpui.app.spotify.com

# --- Optional access control --------------------------------------------------
# Comma-separated Spotify user ids. Empty means any account that Spotify itself
# authenticates may mint a session. Set it for a single-tenant deployment.
ALLOWED_SPOTIFY_USERS=

# --- Limits -------------------------------------------------------------------
# Brand import is documented at 30-60s, so its route overrides the default.
UPSTREAM_TIMEOUT_MS=30000
SPOTIFY_TIMEOUT_MS=5000
MAX_BODY_BYTES=131072
RATE_LIMIT_PER_MINUTE=120
SESSION_RATE_LIMIT_PER_MINUTE=10

# --- Logging ------------------------------------------------------------------
# error | warn | info | debug. Credential-shaped strings are redacted at every
# level; debug adds upstream status and timing per request.
LOG_LEVEL=info

# Set when running behind a proxy or load balancer you control, so client
# addresses are read from X-Forwarded-For for rate limiting. Off by default,
# because trusting that header unconditionally lets a caller forge its identity.
TRUST_PROXY_HEADERS=false
